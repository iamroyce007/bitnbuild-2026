{
  "manifest_version": 3,
  "name": "PhishGraph Guard",
  "short_name": "PhishGraph",
  "version": "1.3.0",
  "description": "Checks the pages you open and the emails you read in Gmail against your PhishGraph server, with explainable verdicts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "permissions": [
    "storage",
    "webNavigation",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://phishgraph.vercel.app/*",
    "http://localhost:8000/*",
    "http://localhost:5173/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/gmail.js"
      ],
      "css": [
        "src/gmail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://phishgraph.vercel.app/*",
        "http://localhost:8000/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "src/connect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/warning.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}