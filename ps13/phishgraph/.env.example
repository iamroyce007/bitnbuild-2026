# ---- storage (leave empty to use the zero-dependency local fallbacks) ----
DATABASE_URL=postgresql://phishgraph:phishgraph@postgres:5432/phishgraph
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# ---- security ----
API_KEYS=change-me-long-random-key          # comma-separated; clients send X-API-Key
RATE_LIMIT_PER_MINUTE=600
ALLOW_PRIVATE_TARGETS=false                 # SSRF guard; never true outside an isolated lab
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- external threat intelligence (all optional; nothing is called unless enabled) ----
ENABLE_EXTERNAL_TI=false
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
URLSCAN_SUBMIT=false                        # search history only unless true
URLSCAN_VISIBILITY=private
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
PHISHTANK_APP_KEY=
ENABLE_ACTIVE_ENRICHMENT=true               # DNS / RDAP / TLS / ASN (public, no key)
FEED_REFRESH_MINUTES=30

# ---- live mailboxes (explicit opt-in) ----
ENABLE_LIVE_EMAIL=false
RESPONSE_LIVE_ACTIONS=false                 # never touches real mail unless true
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_MAILBOX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- behaviour ----
DEMO_MODE=true
ENABLE_EMBEDDINGS=true
WORKER_CONCURRENCY=8
# fusion weights and decision thresholds
W_NLP=0.30
W_URL=0.25
W_TI=0.20
W_GRAPH=0.15
W_BRAND=0.05
W_META=0.05
T_FLAG=30
T_QUARANTINE=60
T_BLOCK=85
